[Unit]
Description=Keep this unit's machine-id across the power cycle
Documentation=https://github.com/Svendsys/otp/issues/21
DefaultDependencies=no
# The store is on the FAT boot partition, so it has to be mounted first.
After=local-fs.target
Before=sysinit.target
# DefaultDependencies=no drops the implicit shutdown ordering, so it has to
# be stated -- the same reason otp-unit-etc-cups.service states it.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/otp-unit/persist-identity.sh
# The script writes its notes to stderr. journal+console puts this unit's
# stderr on the screen during boot, because the journal is volatile and a
# locked-out operator cannot read it. The script prints no hash, only
# lengths, and also leaves refusals on the boot partition (CRED_NOTE there).
StandardOutput=journal
StandardError=journal+console

[Install]
WantedBy=sysinit.target

[Unit]
Description=Report the overlay root to the tier-3 image boot
Documentation=https://github.com/Svendsys/otp/issues/9
# Only harness/img-boot.sh puts otp.imgcheck on the kernel command line, so
# on a flashed appliance this unit is skipped. It ships anyway so tier 3
# tests the image people flash.
ConditionKernelCommandLine=otp.imgcheck

# After, not Requires. A unit that failed to start is one of the things this
# is here to report, and Requires= would take the reporter down with it.
After=otp-unit.service cups.service otp-unit-etc-cups.service

[Service]
Type=oneshot
ExecStart=/opt/otp-unit/img-guest-check.sh
# systemd's default 90s is less than the probe's bounded waits add up to
# under emulation. 480s clears the worst case and stays inside the 600s
# per-boot backstop CI gives the emulator; tests/test_overlay_root.py
# re-derives the sum from the shipped probe.
TimeoutStartSec=480
# The console is the only channel out of the emulator; the journal is
# volatile.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target

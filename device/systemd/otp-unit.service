[Unit]
Description=OTP pad print unit
Documentation=https://github.com/Svendsys/otp
After=cups.service otp-unit-etc-cups.service
Wants=cups.service
Requires=otp-unit-etc-cups.service

# The unit owns tty1 as its front panel; StandardInput=tty-force below takes
# the console even from a getty. A login prompt is on tty2 (Alt+F2).
#
# Not Conflicts=getty@tty1.service: anything that starts that getty would
# then stop this unit, and userconf-pi's cancel-rename starts it after
# applying a seeded credential. device/install.sh puts a condition on the
# getty instead.

[Service]
Type=simple
# No swap, enforced here as well as by install.sh's swap.target mask, before
# any key material can exist. '-': no swap to turn off is the normal case.
ExecStartPre=-/sbin/swapoff -a
ExecStart=/usr/bin/python3 -m otpunit
# Not /opt/otp-unit: lgpio creates a notification FIFO in the working
# directory on import, and under ProtectSystem=strict that is read-only, so
# gpiozero would silently fall back to a pin factory that cannot work.
# LG_WD is lgpio's own name for the same setting.
WorkingDirectory=/run/otp-unit
Environment=LG_WD=/run/otp-unit
Environment=PYTHONPATH=/opt/otp-unit
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
# Above systemd's default 5-starts-in-10s burst limit, so a display that is
# slow to appear on the I2C bus cannot put the unit permanently into failed.
RestartSec=15

# /boot/firmware is writable only so settings can be saved; key material
# never goes there. PrivateTmp is backed by the host's /tmp, not RAM, so
# TMPDIR points at the unit's tmpfs runtime directory.
RuntimeDirectory=otp-unit
Environment=TMPDIR=/run/otp-unit
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# The leading '-' matters: without it, a missing path fails namespace setup
# and the service never starts at all (226/NAMESPACE).
ReadWritePaths=-/boot/firmware
NoNewPrivileges=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
# A core dump would be a complete copy of the pad currently in memory.
LimitCORE=0

# Needs the console for the OLED and GPIO, and poweroff for a clean shutdown.
# `input` is for reading a USB keyboard when there is no GPIO button.
SupplementaryGroups=lp gpio i2c input

# Bound to tty1 so a monitor and USB keyboard work as a front panel when no
# OLED is fitted. This alone does not pick the interface: otpunit/hmi checks
# the DRM connector and looks for a real keyboard before choosing the
# console; otherwise it prints unattended.
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target

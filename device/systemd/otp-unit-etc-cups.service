[Unit]
Description=Lay a tmpfs over /etc/cups so print queues never persist
DefaultDependencies=no
Before=cups.service
After=local-fs.target
# DefaultDependencies=no drops the implicit shutdown ordering, so it has to
# be stated: without it ExecStop runs at an arbitrary point during shutdown
# and unmounts a still-busy /etc/cups.
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathIsDirectory=/opt/otp-unit/cups-etc

[Service]
Type=oneshot
RemainAfterExit=yes
# The root is a read-only overlay, so /etc/cups gets a tmpfs repopulated from
# a baked-in template each boot: the queue is rebuilt from the printer
# actually plugged in, and no record of previous printers survives.
ExecStart=/bin/mount -t tmpfs -o mode=0755,size=4M tmpfs /etc/cups
ExecStart=/bin/sh -c 'cp -a /opt/otp-unit/cups-etc/. /etc/cups/'
ExecStop=/bin/umount /etc/cups

[Install]
WantedBy=sysinit.target
